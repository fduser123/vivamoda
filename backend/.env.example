[TEMPLATE]
# --- Servidor ---
PORT=3000

# --- Base de datos PostgreSQL (coincide con backend/docker-compose.yml) ---
DATABASE_URL=postgres://vivamoda:vivamoda_dev@localhost:5432/vivamoda

# --- Autenticación JWT ---
# Cámbialo en producción (puedes generarlo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=cambia-este-secreto-en-produccion

# --- IA Estilista (opcional) ---
# Sin ninguna API key el backend usa el motor de recomendación local basado en reglas.
# Todos los proveedores hablan la API compatible con OpenAI, así que cambiar de uno
# a otro es solo cuestión de variables de entorno (ver src/services/llm-provider.js).
#
# Prioridad: LLM_BASE_URL/LLM_API_KEY  >  LLM_PROVIDER  >  GEMINI_API_KEY  >  DEEPSEEK_API_KEY  >  OPENROUTER_API_KEY
#
# 1) Google Gemini (AI Studio) — tier gratuito
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_VISION_MODEL=gemini-2.5-flash
#
# 2) DeepSeek (api.deepseek.com · https://platform.deepseek.com)
#    Modelos vigentes: 'deepseek-flash' (V4.1, con visión) y 'deepseek-v4-pro' (solo texto).
#    Los nombres antiguos 'deepseek-chat' / 'deepseek-reasoner' fueron RETIRADOS en 2026.
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_VISION_MODEL=deepseek-flash     # v4-pro NO acepta imágenes

# 3) OpenRouter (también se acepta OPENAI_API_KEY)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
#
# 4) Cualquier API compatible con OpenAI (Groq, Cerebras, Mistral, Ollama local…)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
#
# 5) Forzar un proveedor concreto (si se fuerza y le falta la llave NO se cae a otro)
# LLM_PROVIDER=gemini        # o: deepseek | openrouter
#
# USE_LOCAL_AI=true   # fuerza el motor local de reglas aunque haya API key

# --- Guardas de la IA (rate limit, coste y tamaño de imagen) ---
# Tope único de imagen para /visual-search, /analyze-outfit y /tryon.
# El frontend reduce a JPEG antes de subir; 512 KB cubre una foto de 960 px.
# AI_IMAGE_MAX_KB=512
# Peticiones por minuto y cliente. 0 desactiva la guarda.
# AI_RATE_LIMIT_PER_MIN=30
# AI_IMAGE_RATE_LIMIT_PER_MIN=8
# Presupuesto diario de LLM en USD. 0 desactiva el cost guard.
# AI_DAILY_BUDGET_USD=2

# --- Probador virtual + generación de imágenes (Cloudflare Workers AI · FLUX) ---
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_API_TOKEN=...

# --- Fase 1: asesor de estilismo (RAG) y búsqueda visual ---
# URL del sidecar Python que sirve los embeddings de FashionCLIP.
# Se levanta con: npm run ai:embed   (requiere antes: npm run ai:setup)
# Si no responde, /api/ai/style-chat y /api/ai/visual-search devuelven 503.
# EMBED_SERVICE_URL=http://127.0.0.1:8001

# ============================================================
# DESPLIEGUE EN PRODUCCIÓN (Supabase + Render + HF Spaces)
# ============================================================
# En producción estas variables NO se ponen en este archivo: se configuran en
# el panel de la plataforma (Render → Environment). Este bloque documenta cuáles
# son y de dónde sale cada valor.
#
# DATABASE_URL: cadena de Supabase. Debe terminar en ?sslmode=require
#   postgresql://postgres:CLAVE@db.xxxxx.supabase.co:5432/postgres?sslmode=require
#
# EMBED_SERVICE_URL: URL del Space de Hugging Face (sin barra final)
#   https://usuario-nombre-space.hf.space
#
# JWT_SECRET: genera uno NUEVO y largo. No reutilices el de desarrollo.
#   openssl rand -base64 48
#
# PORT: lo inyecta la plataforma. No lo definas a mano.
