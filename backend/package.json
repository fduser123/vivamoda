{
  "name": "vivamoda-backend",
  "version": "1.0.0",
  "description": "API REST + servidor de la plataforma omnicanal VivaModa (cat\u00e1logo, auth, POS, almac\u00e9n e IA estilista)",
  "type": "module",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "seed:external": "node src/seed-external.js",
    "ai:setup": "bash ai/setup.sh",
    "ai:embed": "ai/.venv/bin/python ai/embed_server.py",
    "ai:attrs": "ai/.venv/bin/python ai/extract_attrs.py",
    "ai:embeddings": "ai/.venv/bin/python ai/build_embeddings.py",
    "ai:validar": "node ai/validar_fase1.mjs",
    "ai:probar": "bash ai/probar-endpoints.sh",
    "f4:synthetic": "ai/.venv/bin/python ai/synthetic_sales.py",
    "f4:features": "ai/.venv/bin/python ai/features.py",
    "f4:2stage": "ai/.venv/bin/python ai/train_two_stage.py",
    "f4:nuevos": "ai/.venv/bin/python ai/new_products.py",
    "f4:inventario": "ai/.venv/bin/python ai/inventory.py",
    "f4:informe": "ai/.venv/bin/python ai/informe_fase4.py",
    "f4:drift": "ai/.venv/bin/python ai/drift_y_futuro.py",
    "f4:pedidos": "ai/.venv/bin/python ai/pedidos_sinteticos.py"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4"
  }
}
