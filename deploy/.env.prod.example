# ============================================================
# Variables del despliegue en una sola VM.
#
#   cp .env.prod.example .env
#   # rellena los tres primeros valores y arranca el compose
#
# deploy/.env NO se versiona (la regla `.env` del .gitignore lo cubre).
# ============================================================

# --- Obligatorias -------------------------------------------------
# Contraseña del PostgreSQL del contenedor. Cualquier cadena larga sirve:
#   openssl rand -base64 24
POSTGRES_PASSWORD=cambia-esto

# Secreto de firma de los JWT. Genera uno NUEVO, no reutilices el de local:
#   openssl rand -base64 48
JWT_SECRET=cambia-esto-tambien

# Dirección pública. Caddy pide el certificado solo si el nombre resuelve a la
# IP de la VM. Sin dominio propio, sslip.io hace ese trabajo:
#   SITE_ADDRESS=203.0.113.10.sslip.io
# (sustituye por la IP pública de tu instancia)
SITE_ADDRESS=203.0.113.10.sslip.io

# --- Opcionales ---------------------------------------------------
# Presupuesto diario de LLM en USD (0 lo desactiva).
AI_DAILY_BUDGET_USD=2
# Peticiones por minuto y cliente en /api/ai (0 lo desactiva).
AI_RATE_LIMIT_PER_MIN=30

# Proveedor de IA. Con una sola clave basta; sin ninguna, el asistente usa el
# motor local de reglas y el resto de la app funciona igual.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Probador virtual (FLUX en Cloudflare Workers AI). Opcional.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
