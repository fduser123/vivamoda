        <mxCell id="n16" value="&lt;b&gt;&lt;font color=&quot;#4B41E1&quot; style=&quot;font-size:11px&quot;&gt;llm-provider.js&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:9px&quot;&gt;resuelve proveedor,&lt;br&gt;coste, timeout y reintentos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B41E1;strokeWidth=1;verticalAlign=middle;align=center;shadow=0;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="95" y="596" width="385" height="72" as="geometry"/></mxCell>
