        <mxCell id="n20" value="Si el proveedor falla o no hay credenciales → motor local de reglas. El servicio no se interrumpe." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B7A3D;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="692" width="1680" height="20" as="geometry"/></mxCell>
        <mxCell id="n21" value="CAPA 3 · SERVICIOS DE IA Y PERSISTENCIA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFAFB;strokeColor=#5C3F45;strokeWidth=2;verticalAlign=top;align=left;fontSize=14;fontColor=#5C3F45;fontStyle=1;dashed=0;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1740" height="540" as="geometry"/></mxCell>
        <mxCell id="n22" value="&lt;b&gt;&lt;font color=&quot;#9C3F00&quot; style=&quot;font-size:13px&quot;&gt;PROVEEDOR LLM EXTERNO (API)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:10px&quot;&gt;DeepSeek · modelo deepseek-flash&lt;br&gt;&lt;br&gt;Se emplea para: lenguaje natural, razonamiento sobre&lt;br&gt;contexto, generación de respuestas e informes y&lt;br&gt;extracción de atributos por visión.&lt;br&gt;&lt;br&gt;Requiere thinking:disabled (el modo razonamiento&lt;br&gt;consumía los tokens y devolvía respuestas vacías).&lt;br&gt;&lt;br&gt;Da servicio a: IA 1 · 2 · 4 · 5 · 6 (parcial)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#9C3F00;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="70" y="780" width="830" height="190" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;b&gt;&lt;font color=&quot;#1B7A3D&quot; style=&quot;font-size:13px&quot;&gt;SIDECAR PYTHON  (proceso local · puerto 8001)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:10px&quot;&gt;FashionCLIP · 512 dimensiones · 150 M de parámetros&lt;br&gt;&lt;br&gt;Se ejecuta en LOCAL sobre CPU: sin coste por consulta&lt;br&gt;ni dependencia de red. Carga el modelo una sola vez.&lt;br&gt;&lt;br&gt;POST /embed/text   ·   POST /embed/image   ·   GET /health&lt;br&gt;&lt;br&gt;Da servicio a: IA 2 · 3 · 6&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B7A3D;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="940" y="780" width="810" height="190" as="geometry"/></mxCell>
        <mxCell id="n24" value="&lt;b&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:14px&quot;&gt;PostgreSQL 16 + extensión pgvector&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:11px&quot;&gt;Fuente de verdad relacional y almacén vectorial en un único motor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F2F5;strokeColor=#5C3F45;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="70" y="1000" width="1680" height="250" as="geometry"/></mxCell>
