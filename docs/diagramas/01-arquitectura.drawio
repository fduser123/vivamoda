        <mxCell id="n12" value="&lt;b&gt;&lt;font color=&quot;#9C3F00&quot; style=&quot;font-size:13px&quot;&gt;IA 4 · Atributos por visión&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:10px&quot;&gt;Ficha técnica de cada prenda&lt;br&gt;modelo visión-lenguaje&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9C3F00;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="70" y="428" width="545" height="100" as="geometry"/></mxCell>
