<mxfile host="app.diagrams.net" version="22.1.0">
  <diagram id="flujo-de-una-peticion" name="Flujo de una peticion">
    <mxGraphModel dx="1422" dy="798" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="&lt;b&gt;Flujo de una Petición a la IA — VivaModa&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#B60055;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell>
        <mxCell id="n2" value="Ciclo completo de una consulta, desde el navegador hasta la respuesta fundamentada" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5C3F45;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1400" height="22" as="geometry"/></mxCell>
        <mxCell id="n3" value="FASE 1 · CAPTURA Y ENVÍO  (navegador → backend)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF6FA;strokeColor=#B60055;strokeWidth=2;verticalAlign=top;align=left;fontSize=14;fontColor=#B60055;fontStyle=1;dashed=0;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1740" height="240" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;&lt;font color=&quot;#B60055&quot; style=&quot;font-size:13px&quot;&gt;1. Usuario&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:11px&quot;&gt;Escribe una consulta en lenguaje natural&lt;br&gt;o sube una fotografía&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B60055;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;&lt;font color=&quot;#B60055&quot; style=&quot;font-size:13px&quot;&gt;2. Frontend&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:11px&quot;&gt;Captura el evento y valida la entrada&lt;br&gt;Adjunta el token de sesión&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B60055;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="510" y="140" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;&lt;font color=&quot;#4B41E1&quot; style=&quot;font-size:12px&quot;&gt;3. Petición HTTP&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:10px&quot;&gt;POST /api/ai/style-chat&lt;br&gt;POST /api/ai/visual-search&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B41E1;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="940" y="140" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;&lt;font color=&quot;#4B41E1&quot; style=&quot;font-size:13px&quot;&gt;4. Backend (proxy)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:11px&quot;&gt;Valida permisos y normaliza&lt;br&gt;la entrada recibida&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B41E1;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1370" y="140" width="370" height="90" as="geometry"/></mxCell>
        <mxCell id="n8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B60055;strokeWidth=2;dashed=0;fontSize=10;fontColor=#5C3F45;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="185" as="sourcePoint"/><mxPoint x="510" y="185" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B60055;strokeWidth=2;dashed=0;fontSize=10;fontColor=#5C3F45;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890" y="185" as="sourcePoint"/><mxPoint x="940" y="185" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B60055;strokeWidth=2;dashed=0;fontSize=10;fontColor=#5C3F45;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="185" as="sourcePoint"/><mxPoint x="1370" y="185" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n11" value="FASE 2 · CONSTRUCCIÓN DEL CONTEXTO Y RECUPERACIÓN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFF;strokeColor=#4B41E1;strokeWidth=2;verticalAlign=top;align=left;fontSize=14;fontColor=#4B41E1;fontStyle=1;dashed=0;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="1740" height="340" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;b&gt;&lt;font color=&quot;#4B41E1&quot; style=&quot;font-size:12px&quot;&gt;5. Extracción de contexto (SQL)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:10px&quot;&gt;Perfil del cliente · pedidos · carrito&lt;br&gt;memoria aprendida · reglas de negocio&lt;br&gt;(excluye datos personales innecesarios)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B41E1;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="80" y="415" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;b&gt;&lt;font color=&quot;#4B41E1&quot; style=&quot;font-size:12px&quot;&gt;6. Planificación de filtros&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:10px&quot;&gt;Heurística local: ocasión, color,&lt;br&gt;precio, género, prenda&lt;br&gt;(4 ms · el LLM solo si no hay señales)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B41E1;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="520" y="415" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;&lt;font color=&quot;#1B7A3D&quot; style=&quot;font-size:12px&quot;&gt;7. Búsqueda vectorial&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:10px&quot;&gt;Embedding de 512 dimensiones&lt;br&gt;similitud coseno sobre índice HNSW&lt;br&gt;top-20 candidatos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B7A3D;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="415" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;&lt;font color=&quot;#1B7A3D&quot; style=&quot;font-size:12px&quot;&gt;8. Re-ranking&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:10px&quot;&gt;Similitud + coincidencia&lt;br&gt;de atributos&lt;br&gt;top-5 finales&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B7A3D;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1400" y="415" width="340" height="120" as="geometry"/></mxCell>
        <mxCell id="n16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4B41E1;strokeWidth=2;dashed=0;fontSize=10;fontColor=#5C3F45;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="475" as="sourcePoint"/><mxPoint x="520" y="475" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4B41E1;strokeWidth=2;dashed=0;fontSize=10;fontColor=#5C3F45;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="475" as="sourcePoint"/><mxPoint x="960" y="475" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1B7A3D;strokeWidth=2;dashed=0;fontSize=10;fontColor=#5C3F45;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="475" as="sourcePoint"/><mxPoint x="1400" y="475" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n19" value="&lt;b&gt;&lt;font color=&quot;#1B7A3D&quot; style=&quot;font-size:12px&quot;&gt;SIDECAR PYTHON · FashionCLIP&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:10px&quot;&gt;Convierte texto e imagen en vectores L2-normalizados.&lt;br&gt;Se ejecuta en local, sin coste por consulta.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B7A3D;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="840" height="120" as="geometry"/></mxCell>
        <mxCell id="n20" value="&lt;b&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:12px&quot;&gt;PostgreSQL + pgvector&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:10px&quot;&gt;Devuelve los productos más afines junto con sus&lt;br&gt;atributos, precio, color y disponibilidad.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F2F5;strokeColor=#5C3F45;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="560" width="780" height="120" as="geometry"/></mxCell>
        <mxCell id="n21" value="FASE 3 · GENERACIÓN, VERIFICACIÓN Y RESPUESTA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FBF4;strokeColor=#1B7A3D;strokeWidth=2;verticalAlign=top;align=left;fontSize=14;fontColor=#1B7A3D;fontStyle=1;dashed=0;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1740" height="240" as="geometry"/></mxCell>
        <mxCell id="n22" value="&lt;b&gt;&lt;font color=&quot;#9C3F00&quot; style=&quot;font-size:12px&quot;&gt;9. Generación (LLM)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:10px&quot;&gt;Recibe únicamente los 5 productos&lt;br&gt;seleccionados como contexto.&lt;br&gt;La instrucción le prohíbe&lt;br&gt;recomendar nada fuera de ellos.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9C3F00;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="80" y="785" width="400" height="130" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;b&gt;&lt;font color=&quot;#1B7A3D&quot; style=&quot;font-size:12px&quot;&gt;10. Verificación de grounding&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:10px&quot;&gt;Comprueba que todo producto&lt;br&gt;nombrado existe en el contexto.&lt;br&gt;Es el criterio de precisión&lt;br&gt;del 100 %.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B7A3D;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="520" y="785" width="400" height="130" as="geometry"/></mxCell>
        <mxCell id="n24" value="&lt;b&gt;&lt;font color=&quot;#4B41E1&quot; style=&quot;font-size:12px&quot;&gt;11. Persistencia y telemetría&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:10px&quot;&gt;Guarda la interacción y los hechos&lt;br&gt;nuevos en ai_memory.&lt;br&gt;Registra tokens, coste y latencia&lt;br&gt;en ai_usage.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B41E1;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="785" width="400" height="130" as="geometry"/></mxCell>
        <mxCell id="n25" value="&lt;b&gt;&lt;font color=&quot;#B60055&quot; style=&quot;font-size:12px&quot;&gt;12. Respuesta al usuario&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:10px&quot;&gt;Renderizado dinámico:&lt;br&gt;tarjetas de producto,&lt;br&gt;indicadores y respuesta&lt;br&gt;textual.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B60055;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1400" y="785" width="340" height="130" as="geometry"/></mxCell>
        <mxCell id="n26" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9C3F00;strokeWidth=2;dashed=0;fontSize=10;fontColor=#5C3F45;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="850" as="sourcePoint"/><mxPoint x="520" y="850" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1B7A3D;strokeWidth=2;dashed=0;fontSize=10;fontColor=#5C3F45;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="850" as="sourcePoint"/><mxPoint x="960" y="850" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4B41E1;strokeWidth=2;dashed=0;fontSize=10;fontColor=#5C3F45;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="850" as="sourcePoint"/><mxPoint x="1400" y="850" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n29" value="respuesta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B60055;strokeWidth=3;dashed=1;fontSize=10;fontColor=#5C3F45;exitX=0.98;exitY=0.5;exitDx=0;exitDy=0;entryX=0.98;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n21" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n30" value="COMPORTAMIENTO ANTE FALLOS (degradación controlada)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#5C3F45;strokeWidth=2;verticalAlign=top;align=left;fontSize=14;fontColor=#5C3F45;fontStyle=1;dashed=0;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1740" height="200" as="geometry"/></mxCell>
        <mxCell id="n31" value="&lt;b&gt;&lt;font color=&quot;#9C3F00&quot; style=&quot;font-size:12px&quot;&gt;Si falla el proveedor LLM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:10px&quot;&gt;El backend captura la excepción y responde con el&lt;br&gt;motor local de reglas. El servicio no se interrumpe&lt;br&gt;y la interfaz indica el motivo.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9C3F00;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="80" y="1045" width="540" height="120" as="geometry"/></mxCell>
        <mxCell id="n32" value="&lt;b&gt;&lt;font color=&quot;#1B7A3D&quot; style=&quot;font-size:12px&quot;&gt;Si falla el sidecar de embeddings&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:10px&quot;&gt;Únicamente los módulos 2, 3 y 6 devuelven error&lt;br&gt;controlado. El resto del sistema sigue operativo,&lt;br&gt;lo que evidencia que son componentes independientes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B7A3D;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="640" y="1045" width="540" height="120" as="geometry"/></mxCell>
        <mxCell id="n33" value="&lt;b&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:12px&quot;&gt;Si faltan credenciales&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5C3F45&quot; style=&quot;font-size:10px&quot;&gt;El sistema arranca en modo local de forma&lt;br&gt;deliberada. Existe una variable de entorno para&lt;br&gt;forzarlo sin retirar las claves.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C3F45;strokeWidth=2;verticalAlign=middle;align=center;shadow=1;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1200" y="1045" width="540" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
