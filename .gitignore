# Dependencias y entorno
node_modules/
.env
*.log

# Entornos virtuales de Python (docs/.venv-doc)
.venv/
.venv-doc/
__pycache__/
*.pyc

# Artefactos de entrenamiento de IA (F0-11). Se regeneran con npm run f4:*
# y no son fuente de verdad: el informe curado (ai/informe-fase4.json) sí se
# versiona. El historial completo queda en ai/artifacts/.
backend/ai/artifacts/
*.joblib
*.parquet
*.onnx
*.pkl

# Archivos temporales de LibreOffice
.~lock.*#

# Imágenes de productos descargadas de APIs externas
# (se regeneran con: cd backend && npm run seed:external)
backend/public/img/ext/

# Descargas originales de Sketchfab (~148 MB). Los .glb ya convertidos
# viven en backend/public/models/; ver docs/DESCARGA_MODELOS_TIENDA.md
downloads/

# Modelos 3D pesados (~100 MB). Ver docs/DESCARGA_MODELOS_TIENDA.md para
# re-descargarlos. Los .glb pequeños (<10 MB) sí se versionan.
backend/public/models/*.glb
backend/public/models/**/*.glb
backend/public/models/**/*.bin
backend/public/models/sponza/
backend/public/models/_cand/

# Excepción: los modelos paramétricos del catálogo SÍ se versionan (pesan pocos
# KB, los sirve la tienda VR y se regeneran con: cd backend && npm run models:3d)
!backend/public/models/generated/
!backend/public/models/generated/**

# Excepción a la regla anterior: el avatar de la asesora 3D (/asesor-de-prendas)
# es un .glb de 1,7 MB, o sea de los "pequeños" que la nota de arriba dice
# versionar. Sin él la página se queda sin modelo en un clon nuevo.
!backend/public/models/asesor/asesor-vivamoda.glb

# Originales de diseño
_originals/

# Sistema
.DS_Store
Thumbs.db
# ============================================================
# DESPLIEGUE: recursos que SÍ deben viajar al repositorio
#
# Sin estas excepciones el despliegue sale roto:
#   · /img/ext/    135 MB · 607 archivos · los usan 303 de 354 productos
#   · modelos 3D    ~69 MB · son el escenario y los objetos de la tienda VR
#
# Se versionan porque son parte del producto: sin ellos el catálogo muestra
# imágenes rotas y la tienda VR se queda vacía. Si el build de Render se hace
# lento, la alternativa es moverlos a un CDN o a Supabase Storage y actualizar
# las rutas, no borrarlos.
# ============================================================
!backend/public/img/ext/
!backend/public/img/ext/**

!backend/public/models/mk-it.glb
!backend/public/models/bolso.glb
!backend/public/models/camiseta.glb
!backend/public/models/gafas-sol.glb
!backend/public/models/sneaker-realista.glb
!backend/public/models/zapatos.glb
